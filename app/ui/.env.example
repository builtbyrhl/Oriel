# Oriel environment configuration template.
#
# Copy to `.env.local` (git-ignored) and fill in real values.
# NEVER commit real credentials.

# --- TMDB (already used by the existing app) ---
NEXT_PUBLIC_TMDB_API_KEY=

# --- Supabase (public / browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only, NEVER expose to the browser) ---
# The URL is public; the service-role key is a secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion guard (server-only) ---
# Shared secret required by POST /api/oriel/ingest to prevent it from being
# used as an unrestricted public database-write endpoint. Fail-closed: if
# unset, the route returns 503.
ORIEL_INGESTION_TOKEN=

# --- AI (server-only, NEVER expose to the browser) ---
# Enrichment runs from server/CLI processes only; it is never called from
# user-facing requests. Either key is sufficient; the provider is chosen via
# ORIEL_AI_PROVIDER, or auto-detected from whichever key is present.
#
# Gemini key rotation / failover: the worker spreads requests round-robin
# across every key found in the environment. Add GEMINI_API_KEY_2 .. _9 (or a
# comma/space-separated GEMINI_API_KEYS list) to scale Gemini quota. If
# OPENROUTER_API_KEY is also set and ORIEL_AI_PROVIDER is unset, Gemini is the
# primary provider with OpenRouter as automatic fallback.
GEMINI_API_KEY=
GEMINI_API_KEY_2=          # optional — used for key rotation/failover
GEMINI_API_KEYS=           # optional — comma/space-separated alternative list
OPENROUTER_API_KEY=
ORIEL_AI_PROVIDER=        # gemini | openrouter (optional)
ORIEL_GEMINI_MODEL=       # optional, default gemini-3.5-flash
ORIEL_OPENROUTER_MODEL=   # optional, default openai/gpt-4o-mini
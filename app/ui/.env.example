# Oriel environment configuration template.
#
# Copy to `.env.local` (git-ignored) and fill in real values.
# NEVER commit real credentials.

# --- TMDB (already used by the existing app) ---
NEXT_PUBLIC_TMDB_API_KEY=

# --- Supabase (public / browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only, NEVER expose to the browser) ---
# The URL is public; the service-role key is a secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion guard (server-only) ---
# Shared secret required by POST /api/oriel/ingest to prevent it from being
# used as an unrestricted public database-write endpoint. Fail-closed: if
# unset, the route returns 503.
ORIEL_INGESTION_TOKEN=